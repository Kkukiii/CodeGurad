# Local private persistence. Use a managed PostgreSQL/Supabase connection in production.
SECURE_REVIEW_DB=./data/reviews.sqlite3
# Set the password locally; URL-encode special characters in it.
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.jspizdverpkdayqjwezo.supabase.co:5432/postgres
APP_ENV=development
PG_CONNECT_TIMEOUT_SECONDS=5
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional server-side AI analysis. Leave blank to use deterministic analysis only.
$env:AI_PROVIDER="openai-compatible"
$env:AI_MODEL="gpt-4o-mini"
$env:AI_API_KEY="replace-with-server-side-provider-key"
$env:AI_BASE_URL="https://api.openai.com/v1"
$env:AI_TIMEOUT_SECONDS="20"

# Server-side Supabase JWT verification secret for HS256 projects. Never expose it to the browser.
# For asymmetric Supabase signing, implement and configure JWKS verification instead.
SUPABASE_JWT_SECRET=replace-in-secret-manager
SUPABASE_JWT_MODE=hs256
SUPABASE_JWT_ISSUER=https://jspizdverpkdayqjwezo.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://jspizdverpkdayqjwezo.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALLOWED_ALGORITHMS=RS256
SUPABASE_JWKS_TIMEOUT_SECONDS=3
SUPABASE_JWKS_CACHE_SECONDS=300

# Operational limits
MAX_SOURCE_BYTES=100000
MAX_FILES_PER_REVIEW=1
REVIEW_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=1
MAX_JOB_ATTEMPTS=2
WORKER_MODE=inline
WORKER_DATABASE_URL=postgresql://worker-user:password@host:5432/database
MAX_REQUEST_BODY_BYTES=110000
MAX_REVIEWS_PER_USER_PER_DAY=100
REQUESTS_PER_MINUTE_PER_INSTANCE=120
MAX_SCANNER_OUTPUT_BYTES=1000000
SCANNER_CPU_SECONDS=60
SCANNER_MEMORY_BYTES=536870912
SCANNER_PROCESS_LIMIT=64
SEMGREP_RULES_PATH=./scanner-rules
LIVE_VERIFY=0
LIVE_TARGET=staging
LIVE_AUTH_URL=https://your-api.example.com/api/v1/reviews
# LIVE_AUTH_TOKEN is configured only in a secure shell for opt-in verification.
