# Reference only: FastAPI reads process environment variables and does not load this file.
APP_ENV=development
SECURE_REVIEW_DB=./data/reviews.sqlite3
DATABASE_URL=postgresql://postgres:Jyoti%401102005@db.jspizdverpkdayqjwezo.supabase.co:5432/postgres
PG_CONNECT_TIMEOUT_SECONDS=5
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure JWKS verification with the Supabase project URL. The backend derives
# the standard JWKS endpoint, issuer, and authenticated audience from this URL.
SUPABASE_URL=https://jspizdverpkdayqjwezo.supabase.co
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_ALLOWED_ALGORITHMS=ES256,RS256
SUPABASE_JWKS_TIMEOUT_SECONDS=5
SUPABASE_JWKS_CACHE_SECONDS=300
# Optional overrides for non-standard Supabase endpoints or claims.
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# For legacy HS256 only, configure this in a secret manager or the process environment.
# SUPABASE_JWT_SECRET=<secret>

# Optional server-side AI; blank values disable hosted analysis.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=20
AI_TOTAL_TIMEOUT_SECONDS=45
# Legacy alias used only when AI_TOTAL_TIMEOUT_SECONDS is unset.
AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=2
AI_MAX_RETRY_DELAY_SECONDS=1
AI_MAX_INPUT_BYTES=150000
AI_MAX_RESPONSE_BYTES=1000000

# Operational limits
MAX_SOURCE_BYTES=100000
MAX_REQUEST_BODY_BYTES=110000
MAX_REVIEWS_PER_USER_PER_DAY=100
REQUESTS_PER_MINUTE_PER_INSTANCE=120
MAX_JOB_ATTEMPTS=2
REVIEW_TIMEOUT_SECONDS=60
MAX_SCANNER_OUTPUT_BYTES=1000000
SCANNER_CPU_SECONDS=60
SCANNER_MEMORY_BYTES=536870912
SCANNER_PROCESS_LIMIT=64
SEMGREP_RULES_PATH=./scanner-rules

# Production dispatch is disabled for review submissions until infrastructure is verified.
PUBLIC_REVIEWS_ENABLED=false
WORKER_MODE=inline
WORKER_DATABASE_URL=

# Optional, explicitly opt-in staging verification.
LIVE_VERIFY=0
LIVE_TARGET=staging
LIVE_AUTH_URL=https://<api-host>/api/v1/reviews
# LIVE_AUTH_TOKEN is configured only in a secure shell.
